// Schéma Prisma officiel pour la plateforme LAKANA
// Compatible PostgreSQL 16 (BCEAO / UMOA Compliance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  nomComplet     String   @map("nom_complet")
  role           String   @default("Analyste conformité")
  hashedPassword String   @map("hashed_password")
  isActive       Boolean  @default(true) @map("is_active")
  mfaEnabled     Boolean  @default(false) @map("mfa_enabled")
  institution    String   @default("SFD Bamako")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Client {
  id             String          @id @default(cuid())
  codeClient     String          @unique @map("code_client")
  nom            String
  prenom         String?
  dateNaissance  String?         @map("date_naissance")
  profession     String?
  ville          String?         @default("Bamako")
  pays           String?         @default("Mali")
  telephone      String?
  estPpe         Boolean         @default(false) @map("est_ppe")
  niveauRisque   String          @default("Faible") @map("niveau_risque")
  riskScore      Int             @default(0) @map("risk_score")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  comptes        Account[]
  transactions   Transaction[]
  alertes        Alert[]
  investigations Investigation[]

  @@map("clients")
}

model Account {
  id            String   @id @default(cuid())
  numeroCompte  String   @unique @map("numero_compte")
  clientId      String   @map("client_id")
  typeCompte    String   @default("Courant") @map("type_compte")
  solde         Float    @default(0.0)
  devise        String   @default("XOF")
  dateOuverture DateTime @default(now()) @map("date_ouverture")

  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Transaction {
  id                   String   @id @default(cuid())
  reference            String   @unique
  clientId             String   @map("client_id")
  compteSourceId       String?  @map("compte_source_id")
  compteDestinationId  String?  @map("compte_destination_id")
  beneficiaireNom      String?  @map("beneficiaire_nom")
  montant              Float
  devise               String   @default("XOF")
  typeOperation        String   @default("Dépôt") @map("type_operation")
  canal                String   @default("Guichet")
  description          String?
  dateTransaction      DateTime @default(now()) @map("date_transaction")

  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, dateTransaction])
  @@map("transactions")
}

model Alert {
  id            String         @id @default(cuid())
  reference     String         @unique
  clientId      String         @map("client_id")
  typeAlerte    String         @map("type_alerte")
  niveau        String         @default("analyser") // bloquante, analyser, informative
  score         Int            @default(0)
  module        String         @default("Risk Score")
  facteurs      String         @default("[]") // Stockage JSON formaté
  statut        String         @default("nouvelle")
  analyste      String?
  createdAt     DateTime       @default(now()) @map("created_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  investigation Investigation?

  @@map("alerts")
}

model Investigation {
  id            String    @id @default(cuid())
  reference     String    @unique
  alerteId      String?   @unique @map("alerte_id")
  clientId      String    @map("client_id")
  analyste      String
  status        String    @default("en_cours") // en_cours, cloturee, transmise
  typeMotif     String?   @map("type_motif")
  decision      String?   // Décision motivée obligatoire (INV-02)
  notesCount    Int       @default(1) @map("notes_count")
  piecesCount   Int       @default(0) @map("pieces_count")
  journalNotes  String?   @map("journal_notes")
  dateOuverture DateTime  @default(now()) @map("date_ouverture")
  dateCloture   DateTime? @map("date_cloture")

  alerte        Alert?    @relation(fields: [alerteId], references: [id], onDelete: SetNull)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("investigations")
}

model SanctionEntry {
  id              String   @id @default(cuid())
  codeEntree      String?  @map("code_entree")
  nomComplet      String   @map("nom_complet")
  aliases         String?
  listeType       String   @map("liste_type") // ONU, GAFI, CENTIF, PPE
  listeNom        String   @map("liste_nom")
  titreFonction   String?  @map("titre_fonction")
  nationalite     String   @default("Mali")
  dateInscription DateTime @default(now()) @map("date_inscription")

  @@map("sanction_entries")
}

model AuditLog {
  id          String   @id @default(cuid())
  utilisateur String
  role        String
  action      String
  module      String
  cible       String?
  details     String?
  ipAddress   String   @default("127.0.0.1") @map("ip_address")
  timestamp   DateTime @default(now())

  @@map("audit_logs")
}